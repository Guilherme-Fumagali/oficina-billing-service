          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/auth/funcionarios",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "funcionarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"{{cpfFuncionario}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Responde 202 com desafioId; a resposta é a mesma para CPF desconhecido."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
