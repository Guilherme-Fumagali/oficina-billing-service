                ]
              }
            }
          ]
        },
        {
          "name": "Webhook do Mercado Pago (assinado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pagamentos/webhooks/mercado-pago?data.id={{mpPaymentId}}&type=payment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pagamentos",
                "webhooks",
                "mercado-pago"
              ],
              "query": [
                {
                  "key": "data.id",
                  "value": "{{mpPaymentId}}"
                },
                {
                  "key": "type",
                  "value": "payment"
                }
              ]
            },
            "description": "Simula a notificação do Mercado Pago. O script calcula o HMAC-SHA256 do manifesto id:{data.id};request-id:{x-request-id};ts:{ts}; com a variável webhookSecret. O estado do pagamento é sempre lido em GET /v1/payments/{id}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"payment.updated\",\n  \"api_version\": \"v1\",\n  \"type\": \"payment\",\n  \"data\": { \"id\": \"{{mpPaymentId}}\" },\n  \"live_mode\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now().toString();",
                  "const requestId = pm.variables.replaceIn('{{$guid}}');",
                  "const dataId = String(pm.collectionVariables.get('mpPaymentId'));",
                  "const idManifesto = /^[A-Za-z0-9]+$/.test(dataId) ? dataId.toLowerCase() : dataId;",
                  "const manifesto = `id:${idManifesto};request-id:${requestId};ts:${ts};`;",
                  "const assinatura = CryptoJS.HmacSHA256(manifesto, pm.collectionVariables.get('webhookSecret')).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'x-signature', value: `ts=${ts},v1=${assinatura}` });",
                  "pm.request.headers.upsert({ key: 'x-request-id', value: requestId });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
